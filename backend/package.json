{
  "name": "holdclose-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Cloudflare Workers backend for the Holdclose caregiver forum.",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "vitest run --config vitest.live.config.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply FORUM_DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply FORUM_DB --remote"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "hono": "^4.6.16"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.5.40",
    "@cloudflare/workers-types": "^4.20250109.0",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.7.2",
    "vitest": "2.1.9",
    "wrangler": "^3.99.0"
  },
  "engines": {
    "node": ">=20"
  }
}
