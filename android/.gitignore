# Remember to never publicly share your keystore.
# See https://flutter.dev/to/reference-keystore
# The release keystore + its credentials NEVER enter git — the app must
# never hold a signing secret in source. build.gradle.kts falls back to
# debug signing when key.properties is absent, so CI/other clones build.
key.properties
holdclose-release.keystore
**/*.keystore
**/*.jks
