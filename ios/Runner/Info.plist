<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Holdclose</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>holdclose</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<!-- Voice quality banner deep-links to Settings → Accessibility →
		     Spoken Content. canLaunchUrl on iOS only returns true when
		     the scheme is declared here; without these entries the
		     fallback chain ends up at the public `app-settings:` URL,
		     which lands on the app's own settings page instead of
		     Accessibility. -->
		<string>App-Prefs</string>
		<string>prefs</string>
	</array>
	<!-- Google Sign-In callback (google_sign_in_ios). The scheme MUST be
	     the REVERSED iOS OAuth client id, e.g. if the iOS client id is
	     `1234567890-abcdef.apps.googleusercontent.com` then the scheme is
	     `com.googleusercontent.apps.1234567890-abcdef`. OPERATOR: replace
	     REVERSED_IOS_CLIENT_ID_PLACEHOLDER below with that reversed id
	     (it pairs with the `--dart-define=GOOGLE_IOS_CLIENT_ID=...` build
	     flag). Without this the Google sheet can't redirect back into the
	     app on iOS. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.948989327057-1m5kkffbqa06p87fprkigumfn3gk6fv3</string>
			</array>
		</dict>
		<!-- Care Circle invite LINKS (2026-06-08). Registers the
		     `holdclose://` custom scheme so a tapped
		     `holdclose://join/<token>` link opens the app; app_links
		     delivers the URI to app.dart, which redeems the token. Mirrors
		     the Android MainActivity intent-filter. -->
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>app.holdclose.invite</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>holdclose</string>
			</array>
		</dict>
	</array>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- Device-capture usage strings (#8). Required by image_picker,
	     record, and speech_to_text so the journal photo/voice-note
	     attach + the Add-sheet voice button can request access on iOS.
	     Copy is caregiver-facing and never names the speech tech (the
	     LLM/recognizer stays invisible per CLAUDE.md voice rules). -->
	<key>NSCameraUsageDescription</key>
	<string>Holdclose uses the camera so you can snap a photo for a journal entry about your loved one.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Holdclose uses the microphone so you can add a voice note or speak an entry instead of typing.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Holdclose needs access to your photos so you can attach one to a journal entry about your loved one.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Holdclose turns what you say into text so you can add an entry by voice instead of typing.</string>
	<!-- Dev-only plain-HTTP exception (iOS ATS blocks http:// by default).
	     localhost: the local LLM shim (tools/claude_shim.py), used when the
	     app points SHIM_URL at http://localhost:8765 for local dev. Remote
	     testers reach the shim over HTTPS via Tailscale Funnel, so no other
	     cleartext hosts are needed. REMOVE for an App Store build — a real
	     backend must be HTTPS. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSExceptionDomains</key>
		<dict>
			<key>localhost</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
		</dict>
	</dict>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
